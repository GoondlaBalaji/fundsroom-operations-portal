            "url": {
              "raw": "{{baseUrl}}/products/categories",
              "host": ["{{baseUrl}}"],
              "path": ["products", "categories"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Industrial Grade Power Relay 24V\",\n  \"sku\": \"IND-REL-24V-01\",\n  \"category\": \"Electrical\",\n  \"unitPrice\": 350.00,\n  \"stock\": 100,\n  \"minStockAlert\": 15,\n  \"warehouseLocation\": \"Rack C-04\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPrice\": 365.00,\n  \"minStockAlert\": 20,\n  \"warehouseLocation\": \"Rack C-05\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "replace-with-product-id" }]
            }
          }
        },
        {
          "name": "Upload Product Image (Amazon S3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "Product image file (JPEG, PNG, WebP, GIF, max 5 MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id/image",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "image"],
              "variable": [{ "key": "id", "value": "replace-with-product-id" }]
            }
          }
        },
        {
          "name": "Delete Product Image (Amazon S3)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id/image",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "image"],
              "variable": [{ "key": "id", "value": "replace-with-product-id" }]
            }
          }
        }
      ]
    },
    {
