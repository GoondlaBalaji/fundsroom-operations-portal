    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Draft Challan (with Snapshots)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"replace-with-customer-id\",\n  \"notes\": \"Urgent dispatch for Saturday delivery\",\n  \"items\": [\n    {\n      \"productId\": \"replace-with-product-id\",\n      \"quantity\": 10\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Get Challan Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "replace-with-challan-id" }]
            }
          }
        },
        {
          "name": "Confirm Challan (Deduct Stock & Create OUT Movement)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"],
              "variable": [{ "key": "id", "value": "replace-with-challan-id" }]
            }
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Client cancelled due to delivery delay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "cancel"],
              "variable": [{ "key": "id", "value": "replace-with-challan-id" }]
            }
          }
        },
        {
          "name": "Export Challan as PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "pdf"],
              "variable": [{ "key": "id", "value": "replace-with-challan-id" }]
            },
            "description": "Exports an official PDF invoice/delivery challan using persisted historical product snapshots and customer details."
          }
        }
      ]
    }
  ]
