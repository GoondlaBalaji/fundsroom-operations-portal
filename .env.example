# ================================================================
# Fundsroom Mini ERP + CRM — Docker Compose Environment Variables
# ================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=fundsroom
POSTGRES_PASSWORD=fundsroom_secret_password
POSTGRES_DB=fundsroom_db
DB_PORT=5433

# Application Ports
BACKEND_PORT=4000
FRONTEND_PORT=5173

# Security
JWT_SECRET=fundsroom-super-secret-jwt-key-change-in-production

# Database Connection URLs:
# - Local non-Docker: postgresql://user:password@localhost:5432/fundsroom_db?schema=public
# - Docker Compose:   postgresql://fundsroom:fundsroom_secret_password@db:5432/fundsroom_db?schema=public
